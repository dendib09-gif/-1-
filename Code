class Sandpile:
    def __init__(self, m=51, h=4, center=None, seed=None):
        self.m = m
        self.h = h
        self.rng = np.random.default_rng(seed)

        self.grid = np.zeros((m, m), dtype=np.int32)

        if center is None:
            center = (m // 2, m // 2)
        self.center = center

        self.avalanche_sizes = []
        self.avalanche_durations = []
        self.grains_lost = []

    def add_grain(self, i=None, j=None):
        if i is None or j is None:
            i, j = self.center
        self.grid[i, j] += 1

    def relax(self):
        n_collapses = 0
        n_steps = 0
        n_lost = 0

        while True:
            unstable = self.grid >= self.h
            if not unstable.any():
                break

            n_steps += 1
            n_collapses += int(unstable.sum())

            delta = np.zeros_like(self.grid)
            delta[unstable] -= self.h
            
            up = np.zeros_like(self.grid)
            up[1:, :] = unstable[:-1, :]

            down = np.zeros_like(self.grid)
            down[:-1, :] = unstable[1:, :]

            left = np.zeros_like(self.grid)
            left[:, 1:] = unstable[:, :-1]

            right = np.zeros_like(self.grid)
            right[:, :-1] = unstable[:, 1:]

            n_lost += int(unstable[0, :].sum())
            n_lost += int(unstable[-1, :].sum())
            n_lost += int(unstable[:, 0].sum())
            n_lost += int(unstable[:, -1].sum())

            delta += up + down + left + right
            self.grid += delta

        return n_collapses, n_steps, n_lost

    def step(self):
        self.add_grain()
        size, duration, lost = self.relax()

        self.avalanche_sizes.append(size)
        self.avalanche_durations.append(duration)
        self.grains_lost.append(lost)

        return size, duration, lost


def plot_power_law(data, xlabel, title, color, outname, fit_range=None, num_bins=20):
    data = np.asarray(data)
    data = data[data > 0]
    if len(data) == 0:
        return


    min_val = data.min()
    max_val = data.max()
    
    bins = np.logspace(np.log10(min_val), np.log10(max_val), num_bins + 1)
    counts, bin_edges = np.histogram(data, bins=bins)
    
    bin_centers = np.sqrt(bin_edges[:-1] * bin_edges[1:])
    
    valid = counts > 0
    values = bin_centers[valid]
    bin_widths = bin_edges[1:] - bin_edges[:-1]
    probs = counts[valid] / (len(data) * bin_widths[valid])


    fig, ax = plt.subplots(figsize=(7, 5))
    
    ax.loglog(values, probs, 'o-', color=color, label='Данные', markersize=6, linewidth=1.5)

    # Фитинг
    if fit_range is not None:
        mask = (values >= fit_range[0]) & (values <= fit_range[1])
    else:
        mask = np.ones_like(values, dtype=bool)
        
    if mask.sum() > 1:
        x_fit = np.log10(values[mask])
        y_fit = np.log10(probs[mask])
        coeffs = np.polyfit(x_fit, y_fit, 1)
        slope = coeffs[0]
        
        x_line = values[mask]
        y_line = 10**(coeffs[1]) * x_line**slope
        ax.loglog(x_line, y_line, 'k--', linewidth=2.5, 
                  label=f'Fit: slope = {slope:.2f}')

    # Оформление осей
    ax.set_xlabel(xlabel, fontsize=14)
    ax.set_ylabel("Плотность вероятности", fontsize=14)
    ax.set_title(title, fontsize=16)
    
    ax.grid(True, which="both", alpha=0.4)
    
    ax.tick_params(axis='both', which='major', labelsize=12, length=6, width=1)
    ax.tick_params(axis='both', which='minor', length=3, width=0.8)
    
    ax.legend(fontsize=12, framealpha=1.0)

    # Подгоняем границы осей
    ax.set_xlim(values.min() * 0.8, values.max() * 1.2)
    ax.set_ylim(probs.min() * 0.5, probs.max() * 2.0)

    fig.tight_layout()
    fig.savefig(outname, dpi=200)
    plt.close(fig)


def main():

    M = 51            # размер решётки
    H = 4             # порог обрушения
    N_STEPS = 20000   # число тактов (добавлений песчинки)
    SEED = 42

    pile = Sandpile(m=M, h=H, seed=SEED)

    print(f"Модель песчаной кучи: m={M}, h={H}, тактов={N_STEPS}")

    snapshots = {}
    snapshot_steps = {0, 100, 1000, 5000, N_STEPS}

    for t in range(1, N_STEPS + 1):
        size, duration, lost = pile.step()
        if t in snapshot_steps:
            snapshots[t] = pile.grid.copy()
        if t % 2000 == 0:
            print(f"  такт {t:>6}: последняя лавина "
                  f"size={size}, duration={duration}, lost={lost}")


    sizes = np.array(pile.avalanche_sizes)
    durations = np.array(pile.avalanche_durations)
    lost = np.array(pile.grains_lost)

    print("\n=== Статистика ===")
    print(f"Всего тактов:            {N_STEPS}")
    print(f"Средний размер лавины:   {sizes.mean():.3f}")
    print(f"Максимальный размер:     {sizes.max()}")
    print(f"Средняя длительность:    {durations.mean():.3f}")
    print(f"Максимальная длит.:      {durations.max()}")
    print(f"Всего ушло песчинок:     {lost.sum()}")
    print(f"Доля тактов без обвалов: "
          f"{(sizes == 0).mean() * 100:.2f}%")


    
    # Снимки состояния
    n_snap = len(snapshots)
    fig, axes = plt.subplots(1, n_snap, figsize=(4 * n_snap, 4.5))
    if n_snap == 1:
        axes = [axes]
    for ax, (t, grid) in zip(axes, sorted(snapshots.items())):
        im = ax.imshow(grid, cmap="viridis", vmin=0, vmax=H)
        ax.set_title(f"t = {t}")
        ax.set_xticks([])
        ax.set_yticks([])
    fig.suptitle("Эволюция песчаной кучи (состояние решётки)", fontsize=13)
    fig.tight_layout()
    fig.savefig("снимки состояния.png", dpi=150)
    plt.close(fig)


    plot_power_law(
        data=sizes,
        xlabel="Размер лавины (число обвалов)",
        title="Распределение размеров лавин",
        color="#4c8cbd",        
        outname="dist_avalanche_size.png",
        fit_range=(20, 50000),
        num_bins=15
    )


    plot_power_law(
        data=durations,
        xlabel="Длительность (число подшагов)",
        title="Распределение продолжительности",
        color="#f28661",        
        outname="dist_avalanche_duration.png",
        fit_range=(8, 1000),
        num_bins=15
    )

    # График динамики размеров лавин во времени
    fig, ax = plt.subplots(figsize=(10, 4))
    ax.plot(sizes, linewidth=0.5, color="steelblue")
    ax.set_xlabel("Такт")
    ax.set_ylabel("Размер лавины")
    ax.set_title("Размер лавин во времени")
    ax.set_yscale("symlog")
    fig.tight_layout()
    fig.savefig("динамика размеров лавин.png", dpi=150)
    plt.close(fig)

    print("\nСохранены файлы:")
    print("  снимки состояния.png  ")
    print("  динамика размеров лавин.png  ")
    print("  dist_avalanche_size.png  ")
    print("  dist_avalanche_duration.png  ")


if __name__ == "__main__":
    main()
